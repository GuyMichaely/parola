{
  "manifest_version": 3,
  "name": "Parola Capture",
  "version": "0.2.2",
  "version_name": "0.2.2",
  "description": "Stage Italian words and contexts for review and import into Parola.",
  "update_url": "https://guymichaely.com/parola/extension/updates.xml",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": [
    "https://guymichaely.com/parola/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stage words in Parola",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://guymichaely.com/parola/*"],
      "js": ["content/parola.js"],
      "run_at": "document_idle"
    }
  ]
}
